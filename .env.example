# Copy to .env.local and fill in. .env.local is never committed.

# Postgres connection string from Supabase: Connect → Connection String → "Transaction pooler"
# (port 6543). Use it locally and when deployed. The session pooler (port 5432) allows only
# about 15 connections in total and runs out ("max clients reached in session mode") once the
# deployed app and your dev server are both connected.
# Put your database password in place of [YOUR-PASSWORD]. Symbols in the password must be
# URL-encoded (e.g. @ becomes %40), so a password of letters and digits is easiest.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

# Optional: path to Supabase's CA certificate (Project Settings → Database → SSL
# configuration → Download certificate). The connection is always encrypted;
# with this set, the server's certificate is verified too.
# DATABASE_SSL_CA=./prod-ca-2021.crt

# Optional: connections the app keeps open (default 5).
# DATABASE_POOL_SIZE=5

# Only for `npm run db:copy-sqlite`: where the old SQLite database is (default ./data/league.db).
# DB_FILE=./data/league.db
