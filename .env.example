# Copy to .env.local and fill in. .env.local is never committed.

# Whoever signs up with this email becomes the admin (comma-separate several).
# The admin can promote other accounts to "official" on the Users page.
ADMIN_EMAIL=you@example.com

# Optional: where the SQLite database file lives (default: ./data/league.db)
# DB_FILE=/var/lib/peace-cup/league.db
